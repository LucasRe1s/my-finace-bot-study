{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "finncy-api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "api.index:app"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "finncy-api", "format": "url", "env": "FINNCY_API_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "finncy-api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
